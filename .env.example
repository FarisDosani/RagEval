# Native Gemini (used in the real study). Supply your own key locally.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Alternative OpenAI-compatible provider: set LLM_PROVIDER=openai.
# LLM_BASE_URL=http://localhost:20128/v1
# LLM_API_KEY=
# LLM_MODEL=your-model-id
# Docker Desktop reaching a host service uses host.docker.internal, not localhost.

# Frontend settings belong in frontend/.env.local (see frontend/.env.example).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000; never put secrets in public vars.

# Local API bootstrap: export these in the shell before Uvicorn (process env).
# RAGEVAL_AUTO_INIT=true
# RAGEVAL_CORPUS_PATH=data/corpus/Week # 02 Slides.pdf
